# Apache / cPanel hosting for the browser demo (#30). Uploaded with the rest
# of the site; other servers are covered in docs/WEB-DEMO.md#publish.

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .js .mjs
  AddType application/json .json
</IfModule>

<IfModule mod_headers.c>
  # Cross-origin isolation for the multi-threaded Wasm renderer.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Entry files are always revalidated, so a new upload shows up at once.
  <FilesMatch "^(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|version\.json|manifest\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# The Wasm and JavaScript files are large and compress well.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm text/javascript application/json text/html
</IfModule>

# Server config files are not meant to be downloaded (Apache usually hides
# .ht* already; this also covers hosts that don't).
<IfModule mod_authz_core.c>
  <FilesMatch "^(_headers|\.htaccess)$">
    Require all denied
  </FilesMatch>
</IfModule>
